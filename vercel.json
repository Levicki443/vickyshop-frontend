{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/produit/:slug*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([wW]hats[aA]pp|[fF]acebookexternalhit|[fF]acebot|[tT]witterbot|[tT]elegram[bB]ot|[lL]inked[iI]n[bB]ot|[sS]lackbot|[dD]iscordbot|[pP]interest|[aA]pplebot|[gG]ooglebot).*"
        }
      ],
      "destination": "https://vickyshop-backend.onrender.com/api/products/:slug*/preview"
    },
    {
      "source": "/share/:slug*",
      "destination": "https://vickyshop-backend.onrender.com/api/products/:slug*/preview"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
